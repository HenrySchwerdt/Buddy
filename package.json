{
  "name": "buddy",
  "private": true,
  "version": "0.1.0",
  "description": "Buddy: an extensible open-source automated insulin delivery research app (React Native), inspired by Trio.",
  "license": "MIT",
  "packageManager": "pnpm@10.6.3",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter mobile typecheck",
    "sim": "tsx packages/simulator/src/cli.ts",
    "mobile": "pnpm --filter mobile start"
  },
  "pnpm": {
    "patchedDependencies": {
      "expo-modules-jsi@58.0.23": "patches/expo-modules-jsi@58.0.23.patch"
    }
  }
}
