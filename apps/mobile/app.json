{
  "expo": {
    "name": "Buddy",
    "slug": "buddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.buddy.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A2237",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.buddy.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030F1C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "./plugins/with-xdrip",
        {
          "developmentTeam": "XXXXXXXXXX"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Buddy connects to your pump and CGM over Bluetooth."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Buddy uses NFC to activate and pair Libre sensors.",
          "includeNdefEntitlement": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false,
          "sounds": [
            "./assets/sounds/urgent.wav",
            "./assets/sounds/beacon.wav",
            "./assets/sounds/pulse.wav",
            "./assets/sounds/siren.wav",
            "./assets/sounds/rise.wav",
            "./assets/sounds/fall.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/ticktock.wav"
          ]
        }
      ],
      "expo-audio",
      "expo-sharing",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Midnight",
            "ios": "./assets/icons/buddy-midnight.png",
            "android": {
              "foregroundImage": "./assets/icons/buddy-midnight-foreground.png",
              "backgroundColor": "#06182A"
            }
          },
          {
            "name": "Daylight",
            "ios": "./assets/icons/buddy-daylight.png",
            "android": {
              "foregroundImage": "./assets/icons/buddy-daylight-foreground.png",
              "backgroundColor": "#E3EDFB"
            }
          },
          {
            "name": "Ember",
            "ios": "./assets/icons/buddy-ember.png",
            "android": {
              "foregroundImage": "./assets/icons/buddy-ember-foreground.png",
              "backgroundColor": "#F2703C"
            }
          }
        ]
      ],
      "expo-background-task",
      "./plugins/with-buddy-native",
      "@bacons/apple-targets",
      ["expo-build-properties", { "android": { "minSdkVersion": 26 } }],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Buddy checks that it may write to Apple Health.",
          "NSHealthUpdateUsageDescription": "Buddy writes your glucose, carbs and insulin to Apple Health."
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-connect",
      [
        "expo-calendar",
        {
          "calendarPermission": "Buddy shows your current glucose as a calendar event.",
          "remindersPermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Buddy asks for Face ID before it delivers a bolus."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
